# AI广告代投系统 - 安全配置示例
# 展示强密钥和配置的最佳实践

# 应用基础配置
APP_NAME=AI广告代投系统
DEBUG=false
ENV_NAME=development

# 数据库配置 - 开发环境使用SQLite
DATABASE_URL=sqlite:///./ai_ad_spend_dev.db

# 强密钥配置 - 使用openssl生成的强随机密钥
# 生成命令:
# JWT Secret: openssl rand -hex 32
# Encryption Key: openssl rand -hex 16
JWT_SECRET=a1b2c3d4e5f6789012345678901234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef12
ENCRYPTION_KEY=f1e2d3c4b5a69780123456789012345678

# JWT令牌过期时间配置
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Supabase配置 - 使用测试环境或开发环境
SUPABASE_URL=https://abcdefghijklmnopqrstuvwxyz.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImFiY2RlZmdoaWprbG1ub3BxcnN0dXZ3eHl6Iiwicm9sZSI6ImFub24iLCJpYXQiOjE2MzQ1Njc4OTAsImV4cCI6MTk1MDE0Mzg5MH0.example
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImFiY2RlZmdoaWprbG1ub3BxcnN0dXZ3eHl6Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTYzNDU2Nzg5MCwiZXhwIjoxOTUwMTQzODkwfQ.example

# CORS配置 - 开发环境
# 格式：逗号分隔（推荐）
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# API安全配置
RATE_LIMIT=1000
RATE_WINDOW=60
MAX_FILE_SIZE=10485760

# 日志配置
LOG_LEVEL=INFO

# Redis配置 (可选)
REDIS_URL=redis://localhost:6379/0

# 严格配置模式 - 开启后将在开发环境也强制要求强配置
STRICT_CONFIG=1

# 监控配置 (可选)
# SENTRY_DSN=https://your-public-key@sentry.io/project-id

# 邮件配置 (可选)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password