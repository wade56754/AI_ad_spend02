# AI广告代投系统 - 开发环境专用配置
# 这个文件只用于开发环境，避免系统环境变量冲突

# 应用基础配置
APP_NAME=AI广告代投系统
DEBUG=true
ENV_NAME=development

# 数据库配置
DATABASE_URL=sqlite:///./ai_ad_spend_dev.db

# JWT和加密配置
JWT_SECRET=dev_secret_key_32_characters_long_1234567890abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ
ENCRYPTION_KEY=dev_encryption_key_32_chars_long_1234567890

# Supabase配置（开发环境）
SUPABASE_URL=https://dev.supabase.co
SUPABASE_ANON_KEY=dev_anon_key_1234567890
SUPABASE_SERVICE_ROLE_KEY=dev_service_role_key_1234567890

# CORS配置 - 明确指定开发环境源
# 格式：逗号分隔（推荐）
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# API配置
RATE_LIMIT=1000
RATE_WINDOW=60
MAX_FILE_SIZE=10485760

# 日志配置
LOG_LEVEL=DEBUG