# Supabase 迁移配置文件
# 请填写您的 Supabase 连接信息（可在 Supabase Dashboard → Settings 中找到）

# 1. Supabase 项目 URL
# 格式: https://xxxxx.supabase.co
SUPABASE_URL=

# 2. Service Role Key（用于管理员操作）
# 位置: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=

# 3. 数据库直连URL（可选）
# 位置: Supabase Dashboard → Settings → Database → Connection string → URI
# 格式: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=

# =========================================
# 配置说明
# =========================================
#
# 方式 1（推荐）：使用 DATABASE_URL 直连
# - 更快速、更稳定
# - 需要数据库密码（在 Database Settings → Connection pooling 中重置）
#
# 方式 2：使用 SUPABASE_URL + SERVICE_ROLE_KEY
# - 通过 Supabase API
# - 功能可能有限制
#
# =========================================
# 填写完成后的操作
# =========================================
#
# 1. 将此文件重命名为: backend/.env
#    或复制内容到 backend/.env
#
# 2. 运行迁移脚本:
#    python backend/run_supabase_migration_interactive.py
#
# 3. 验证迁移:
#    登录 Supabase Dashboard 查看表结构
