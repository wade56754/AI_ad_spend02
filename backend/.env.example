# AI广告代投系统 - 环境变量配置模板
# 复制此文件为 .env 并填入真实值
# ⚠️ 安全警告：绝对不要将包含真实密钥的 .env 文件提交到版本控制系统！

# 应用基础配置
APP_NAME=AI广告代投系统
APP_VERSION=2.3.0
DEBUG=false
ENV_NAME=production

# 数据库配置 - 生产环境必须使用PostgreSQL
# 开发环境: sqlite:///./ai_ad_spend_dev.db
# 生产环境: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://username:password@localhost:5432/ai_ad_spend_prod

# 数据库连接池配置
POOL_SIZE=20
MAX_OVERFLOW=30
POOL_TIMEOUT=30
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE=3600

# RLS和审计日志配置
ENABLE_RLS=true
ENABLE_AUDIT_LOG=true
AUDIT_LOG_RETENTION_DAYS=365

# JWT和加密配置 - ⚠️ 必须使用强随机密钥！
# 生成命令: openssl rand -hex 32 (32字节=64字符)
JWT_SECRET=your_64_character_jwt_secret_key_here_minimum_length_required
ENCRYPTION_KEY=your_32_character_encryption_key_here_minimum_length_required
PASSWORD_SALT_ROUNDS=12

# JWT令牌过期时间配置
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Supabase配置 (如果使用Supabase)
# 获取地址: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# CORS配置 - 生产环境必须限制允许的域名
# 开发环境示例: ["http://localhost:3000","http://127.0.1:3000"]
# 生产环境示例: ["https://yourdomain.com","https://app.yourdomain.com"]
# 格式：逗号分隔（推荐）
ALLOWED_ORIGINS=https://yourdomain.com

# API安全配置
RATE_LIMIT=1000
RATE_WINDOW=60
MAX_FILE_SIZE=10485760
BCRYPT_ROUNDS=12

# 日志配置
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_REQUEST_ID_ENABLED=true

# AI监控配置
AI_MONITORING_ENABLED=true
AI_ANOMALY_DETECTION_ENABLED=true
AI_PREDICTION_ENABLED=true
AI_MODEL_VERSION=1.0

# 通知配置
NOTIFICATION_ENABLED=true
EMAIL_NOTIFICATIONS_ENABLED=true
SMS_NOTIFICATIONS_ENABLED=false
SLACK_WEBHOOK_URL=

# 审计日志配置
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=365
AUDIT_LOG_INCLUDE_SENSITIVE=false

# 安全强化模式 (可选)
# 设置为1将在任何环境都强制要求强密码和安全配置
STRICT_CONFIG=0
SESSION_TIMEOUT=1800
MAX_LOGIN_ATTEMPTS=5

# Redis配置 (如果使用Redis缓存)
REDIS_URL=redis://localhost:6379/0
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=20

# 任务队列配置 (如果使用Celery/RQ)
TASK_QUEUE_ENABLED=true
TASK_QUEUE_BROKER_URL=redis://localhost:6379/1
TASK_QUEUE_RESULT_BACKEND=redis://localhost:6379/2

# 监控配置 (如果使用Sentry)
SENTRY_DSN=your_sentry_dsn_here
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_ENVIRONMENT=production

# 外部服务配置
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_USE_TLS=true

# Facebook API配置 (如果集成Facebook)
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_API_VERSION=v18.0

# 文件存储配置
STORAGE_TYPE=local
# AWS S3 (如果使用AWS)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
STORAGE_BASE_URL=

# 性能监控配置
PERFORMANCE_MONITORING_ENABLED=true
METRICS_COLLECTION_INTERVAL=60
SLOW_QUERY_THRESHOLD=1000

# 数据备份配置
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"  # 每天凌晨2点
BACKUP_RETENTION_DAYS=90
BACKUP_ENCRYPTION_KEY=your_backup_encryption_key