# AI广告代投系统 - 测试环境配置
# 用于pytest测试和CI/CD环境
# 安全说明：测试环境使用固定密钥，不能用于生产环境

# 应用基础配置
APP_NAME=AI广告代投系统-测试环境
APP_VERSION=2.3.0
DEBUG=true
ENV_NAME=development
ENVIRONMENT=test

# 数据库配置 - 使用SQLite内存数据库或独立测试数据库
DATABASE_URL=sqlite:///./ai_ad_spend_unit.db

# 数据库连接池配置（简化）
POOL_SIZE=5
MAX_OVERFLOW=10
POOL_TIMEOUT=10
DB_POOL_PRE_PING=false
DB_POOL_RECYCLE=3600

# RLS和审计日志配置（测试环境可选）
ENABLE_RLS=false
ENABLE_AUDIT_LOG=false
AUDIT_LOG_RETENTION_DAYS=7

# JWT和加密配置 - 测试环境使用固定密钥
JWT_SECRET=test_jwt_secret_key_for_testing_environment_do_not_use_in_production_12345678
SECRET_KEY=test_secret_key_32_characters_long_123456
ENCRYPTION_KEY=test_encryption_key_32_chars_long_123456
ALGORITHM=HS256
PASSWORD_SALT_ROUNDS=4  # 降低轮数加快测试速度

# JWT令牌过期时间配置（测试环境延长）
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Supabase配置（测试环境可以使用mock或禁用）
SUPABASE_URL=https://unittest-project.supabase.co
SUPABASE_ANON_KEY=unittest_anon_key_12345678901234567890
SUPABASE_SERVICE_ROLE_KEY=unittest_service_role_key_12345678901234567890
SUPABASE_JWT_SECRET=unittest_supabase_jwt_secret_key_for_testing

# CORS配置 - 测试环境允许所有来源
# 格式：逗号分隔（推荐）或紧凑JSON数组（无空格）
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,*

# API安全配置（测试环境放宽限制）
RATE_LIMIT=10000
API_RATE_LIMIT=10000
RATE_WINDOW=60
MAX_FILE_SIZE=10485760
BCRYPT_ROUNDS=4

# 日志配置
LOG_LEVEL=DEBUG
LOG_FORMAT=text
LOG_REQUEST_ID_ENABLED=false

# AI监控配置（测试环境禁用）
AI_MONITORING_ENABLED=false
AI_ANOMALY_DETECTION_ENABLED=false
AI_PREDICTION_ENABLED=false
AI_MODEL_VERSION=1.0

# 通知配置（测试环境禁用）
NOTIFICATION_ENABLED=false
EMAIL_NOTIFICATIONS_ENABLED=false
SMS_NOTIFICATIONS_ENABLED=false
SLACK_WEBHOOK_URL=

# 审计日志配置（测试环境简化）
AUDIT_LOG_ENABLED=false
AUDIT_LOG_INCLUDE_SENSITIVE=false

# 安全强化模式（测试环境关闭）
STRICT_CONFIG=0
SESSION_TIMEOUT=3600
MAX_LOGIN_ATTEMPTS=100

# Redis配置（测试环境使用15号数据库避免冲突）
REDIS_URL=redis://localhost:6379/15
REDIS_DB=15
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=5

# 任务队列配置（测试环境禁用）
TASK_QUEUE_ENABLED=false

# 监控配置（测试环境禁用Sentry）
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_ENVIRONMENT=test

# 文件存储配置（测试环境使用本地存储）
STORAGE_TYPE=local

# 性能监控配置（测试环境禁用）
PERFORMANCE_MONITORING_ENABLED=false

# 数据备份配置（测试环境禁用）
BACKUP_ENABLED=false

# 测试专用配置
TEST_MODE=true
PYTEST_RUNNING=true