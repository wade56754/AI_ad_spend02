#!/bin/sh
# AI 广告代投系统 - Pre-commit Hook
# 1. SoT 5秒扫描 (AI防幻觉检查)
# 2. lint-staged (代码格式化)

# 使用绝对路径，避免路径问题
PROJECT_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"

# 设置 PATH，确保 node_modules/.bin 可用
export PATH="$PROJECT_ROOT/frontend/node_modules/.bin:$PROJECT_ROOT/node_modules/.bin:$PATH"

# SoT 5秒扫描
"$PROJECT_ROOT/scripts/sot-scan.sh" || exit $?

# lint-staged
cd "$PROJECT_ROOT/frontend" && npx lint-staged
