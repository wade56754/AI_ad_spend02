{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "投手日报事实表（投手自报）",
  "description": "Domain: 人域 | Grain: 每日每投手每地区汇报",
  "type": "object",
  "properties": {
    "date": {
      "type": [
        "string",
        "null"
      ],
      "examples": [
        "2025-01-31",
        "2025-01-30",
        "2025-01-01"
      ]
    },
    "media_buyer": {
      "type": [
        "string",
        "null"
      ],
      "examples": [
        "老郭",
        "紫光",
        "WD"
      ]
    },
    "region": {
      "type": [
        "string",
        "null"
      ],
      "examples": [
        "IN",
        "IN",
        "IN"
      ]
    },
    "team": {
      "type": [
        "string",
        "null"
      ],
      "examples": [
        "SZ",
        "SZ",
        "ZZ"
      ]
    },
    "ad_spend_usd": {
      "type": [
        "number",
        "null"
      ],
      "examples": [
        "242.24",
        "270.35",
        "0.0"
      ]
    },
    "result_count": {
      "type": [
        "number",
        "null"
      ],
      "examples": [
        "28.0",
        "33.0",
        "0.0"
      ]
    },
    "lead_count": {
      "type": [
        "number",
        "null"
      ],
      "examples": [
        "5.0",
        "16.0",
        "0.0"
      ]
    },
    "platform": {
      "type": [
        "string",
        "null"
      ],
      "examples": [
        "FB",
        "FB",
        "FB"
      ]
    },
    "cost_per_lead": {
      "type": [
        "number",
        "null"
      ],
      "examples": [
        "48.448",
        "16.896875",
        "26.9705"
      ]
    },
    "cost_per_result": {
      "type": [
        "number",
        "null"
      ],
      "examples": [
        "48.448",
        "16.896875",
        "26.9705"
      ]
    }
  },
  "required": [
    "date",
    "media_buyer",
    "region",
    "team",
    "ad_spend_usd",
    "result_count",
    "lead_count"
  ]
}